# Токен бота от @BotFather (обязательно)
BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER

# Telegram ID администраторов через запятую
ADMIN_IDS=547169256

# Путь к файлу SQLite (относительно WorkingDirectory сервиса)
DATABASE_PATH=data/site_checker.db

# Как часто планировщик просматривает очередь проверок, секунды
CHECK_TICK_SECONDS=15

# Таймаут HTTP-запроса к сайту, секунды
HTTP_TIMEOUT_SECONDS=15

# Сколько сайтов проверяется одновременно
MAX_CONCURRENT_CHECKS=10

# Сколько неудачных проверок подряд нужно для уведомления о падении
# (1 = уведомлять сразу при первой ошибке; 2-3 спасает от ложных срабатываний)
FAILURE_THRESHOLD=1

# Максимум сайтов на одного пользователя (0 = без лимита)
MAX_SITES_PER_USER=50

# Автобэкап БД (VACUUM INTO): каталог, интервал в часах и сколько копий хранить
# BACKUP_KEEP=0 отключает бэкапы. Каталог должен быть доступен на запись сервису.
BACKUP_DIR=data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Уровень логов: error | warn | info | debug
RUST_LOG=info